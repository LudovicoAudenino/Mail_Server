<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.ludovico.client.controller.MailboxController">
  
  <!-- Top: Header with user info and buttons -->
  <top>
    <VBox spacing="10.0">
      <padding>
        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
      </padding>
      
      <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label fx:id="userEmailLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="User: " />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="composeButton" onAction="#handleCompose" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Compose Email" />
        <Button fx:id="refreshButton" onAction="#handleRefresh" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Refresh" />
        <Button fx:id="deleteButton" onAction="#handleDelete" style="-fx-background-color: #FF9800; -fx-text-fill: white;" text="Delete Email" />
        <Button fx:id="logoutButton" onAction="#handleLogout" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Logout" />
      </HBox>
      
      <Separator />
    </VBox>
  </top>
  
  <!-- Center: Split between email list and content -->
  <center>
    <SplitPane dividerPositions="0.5" orientation="VERTICAL">
      
      <!-- Top half: Email list -->
      <VBox>
        <Label style="-fx-font-weight: bold; -fx-padding: 10 0 5 20;" text="Emails:" />
        <TableView fx:id="emailTable" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="fromColumn" prefWidth="200.0" text="From" />
            <TableColumn fx:id="subjectColumn" prefWidth="300.0" text="Subject" />
            <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date" />
          </columns>
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
        </TableView>
      </VBox>
      
      <!-- Bottom half: Email content -->
      <VBox>
        <Label style="-fx-font-weight: bold; -fx-padding: 10 0 5 20;" text="Content:" />
        <TextArea fx:id="emailContentArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS">
          <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
          </VBox.margin>
        </TextArea>
      </VBox>
      
    </SplitPane>
  </center>
  
</BorderPane>
