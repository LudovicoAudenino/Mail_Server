<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.ludovico.client.controller.ComposeEmailController">
  
  <!-- Top: Header -->
  <top>
    <VBox spacing="10.0">
      <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding>
      
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Compose New Email" />
      <Separator />
    </VBox>
  </top>
  
  <!-- Center: Email form -->
  <center>
    <VBox spacing="15.0">
      <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
      </padding>
      
      <!-- From field (read-only) -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="fromLabel" minWidth="60.0" text="From:" />
      </HBox>
      
      <!-- To field -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label minWidth="60.0" text="To:" />
        <TextField fx:id="toField" promptText="Enter recipient email(s), comma-separated" HBox.hgrow="ALWAYS" />
      </HBox>
      
      <!-- Subject field -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label minWidth="60.0" text="Subject:" />
        <TextField fx:id="subjectField" promptText="Enter email subject" HBox.hgrow="ALWAYS" />
      </HBox>
      
      <Separator />
      
      <!-- Message area -->
      <VBox spacing="5.0" VBox.vgrow="ALWAYS">
        <Label text="Message:" />
        <TextArea fx:id="messageArea" promptText="Enter your message here..." VBox.vgrow="ALWAYS" wrapText="true" />
      </VBox>
      
    </VBox>
  </center>
  
  <!-- Bottom: Action buttons -->
  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
      <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
      </padding>
      
      <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel" />
      <Button fx:id="sendButton" onAction="#handleSend" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Send Email" />
    </HBox>
  </bottom>
  
</BorderPane>