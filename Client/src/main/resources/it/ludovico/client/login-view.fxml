<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.ludovico.client.controller.LoginController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>

  <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Mail Client Login" />
  
  <VBox spacing="10.0">
    <Label text="Email Address:" />
    <TextField fx:id="emailField" promptText="Enter your email address" />
  </VBox>
  
  <Button fx:id="loginButton" onAction="#handleLogin" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Login" />
  
  <Label style="-fx-font-size: 12px; -fx-text-fill: gray;" text="Available accounts: ludo@gmail.com, franci@gmail.com, elisa@gmail.com" />
</VBox>