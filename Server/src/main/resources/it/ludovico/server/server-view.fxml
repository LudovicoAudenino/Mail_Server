<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.ludovico.server.controller.ServerController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
   <TextArea fx:id="statusLog" wrapText="true" VBox.vgrow="ALWAYS" />
   <HBox alignment="CENTER" spacing="50.0">
      <children>
        <Button fx:id="turnOn" onAction="#serverOn" text="Turn on" />
         <Button fx:id="turnOff" mnemonicParsing="false" onAction="#serverOff" text="Turn off" />
      </children>
   </HBox>
</VBox>
