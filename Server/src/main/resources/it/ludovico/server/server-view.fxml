<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.ludovico.server.controller.ServerController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
   <children>
      <!-- Title -->
      <Label text="Mail Server Dashboard" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <!-- Statistics Panel -->
      <HBox alignment="CENTER" spacing="50.0" style="-fx-background-color: #f0f0f0; -fx-padding: 15; -fx-background-radius: 10;">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="Server Status">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="serverStatusLabel" text="STOPPED" textFill="#d32f2f">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="Server Port">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label text="8888">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
      
      <!-- Control Button -->
      <Button fx:id="toggleServerButton" mnemonicParsing="false" onAction="#toggleServer" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 25;" text="START SERVER" />
      
      <!-- Logs Section -->
      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Server Logs">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <TextArea fx:id="logsTextArea" editable="false" prefHeight="300.0" style="-fx-font-family: 'Courier New'; -fx-font-size: 12px;" wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="clearLogsButton" mnemonicParsing="false" onAction="#clearLogs" style="-fx-background-color: #ff9800; -fx-text-fill: white;" text="Clear Logs" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
