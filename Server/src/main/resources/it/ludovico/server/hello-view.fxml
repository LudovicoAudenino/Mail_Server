<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.ludovico.server.HelloController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
   <TextArea fx:id="statusLog" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
   <HBox alignment="CENTER" prefHeight="1.0" prefWidth="200.0" spacing="50.0">
      <children>
        <Button onAction="#serverOnClick" text="Turn on" />
         <Button mnemonicParsing="false" text="Turn off" />
      </children>
   </HBox>
</VBox>
